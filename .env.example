# Murieron en Madrid — API
# Copiar a .env y completar. El proceso NO arranca si falta alguna obligatoria:
# la validacion corre en el bootstrap (src/globals/env.validation.ts).

PORT=3000

# Origen del frontend. Admite varios separados por coma.
CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mem
MYSQL_PASSWORD=123456789
MYSQL_DATABASE=murieron_en_madrid

# Clave unica de administracion: habilita TODAS las operaciones de escritura.
# Minimo 8 caracteres.
ADMIN_PASSWORD=cambiame-por-favor

# Secreto con el que se firma el token del login. Minimo 16 caracteres, y que
# sea aleatorio: cambiarlo invalida todas las sesiones abiertas.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=cambiame-por-una-cadena-larga-y-aleatoria

# Vida del token de admin (formato de ms: 15m, 12h, 7d).
ADMIN_TOKEN_EXPIRES_IN=12h

# Solo para scripts/apply-sql.mjs: los procedures pertenecen a root y MySQL 8
# no deja que un usuario comun los reemplace.
MYSQL_ROOT_PASSWORD=root
